# Copie ce fichier en ".env" et renseigne tes clés (ou saisis-les directement
# dans la barre latérale de l'application - les deux fonctionnent).

# Obligatoire pour la génération de stratégie (email + blueprint d'appel).
# Clé gratuite à créer sur https://console.anthropic.com/ (facturée à l'usage,
# pas d'abonnement - quelques centimes par génération pour ce cas d'usage).
ANTHROPIC_API_KEY=

# Optionnelle : améliore l'enrichissement automatique pour le Portugal.
# Clé gratuite sur https://www.nif.pt/contactos/api/ (formulaire par email).
# Sans elle, l'app propose un lien de recherche manuelle à la place.
NIF_PT_API_KEY=
